# Copy to .env. Never commit .env.
FEED_URL=https://your-feed.example.com
FEED_TOKEN=
# sites or cloudflare-access; must match the Worker's AUTH_MODE
AUTH_MODE=sites
# From the T3 Code scheduled task, see docs/t3-code.md
T3_WEBHOOK_URL=
# Your X handle without the @. Needed for posting.
X_HANDLE=
# Codex model for the posting agent
POST_MODEL=gpt-6.1-terra
PIECES_DIR=pieces
# Set to 1 to cross-post to LinkedIn after X
LINKEDIN=0
